{
  "name": "nova-grid",
  "version": "1.1.0",
  "description": "Several Claude Code terminals in one window, each in its own folder",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.3",
    "node-pty": "^1.1.0"
  },
  "productName": "Nova Grid",
  "build": {
    "appId": "com.acuz3d.novagrid",
    "productName": "Nova Grid",
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "files": [
      "**/*",
      "!backgrounds/**",
      "!dist/**",
      "!*.lnk",
      "!README.md",
      "!node_modules/node-pty/{deps,third_party,src,scripts,binding.gyp}/**",
      "!node_modules/node-pty/prebuilds/{darwin-*,win32-arm64}/**",
      "!node_modules/node-pty/**/*.pdb"
    ],
    "asarUnpack": [
      "statusline.js",
      "node_modules/node-pty/**",
      "node_modules/koffi/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nova Grid",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Nova-Grid-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Acuz3D",
        "repo": "nova-grid"
      }
    ]
  }
}
